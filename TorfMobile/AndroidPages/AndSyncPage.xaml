<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="TorfMobile.AndSyncPage"
    Title="Synchronizacja"
    BackgroundColor="{AppThemeBinding Light=#F6F7FA, Dark=#111827}">

    <ScrollView>
        <VerticalStackLayout Padding="16,18,16,36"
                             Spacing="14">

            <!-- Nagłówek -->
            <VerticalStackLayout Spacing="5">
                <Label Text="Synchronizacja zliczeń"
                       FontSize="25" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                <Label Text="Przesyłanie danych wyłącznie w sieci lokalnej."
                       FontSize="13"
                       TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
            </VerticalStackLayout>

            <!-- Urządzenie docelowe / partner -->
            <Border Padding="15" StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#475569}"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E293B}"
                    StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Text="1. Połączone urządzenie"
                               VerticalOptions="Center" FontSize="17" FontAttributes="Bold" />
                        <Button Grid.Column="1" Text="Odśwież"
                                Command="{Binding RefreshPeersCommand}"
                                FontSize="12" Padding="12,7" />
                    </Grid>
                    <Picker Title="Wybierz połączone urządzenie"
                            ItemsSource="{Binding ConnectedDevices}"
                            SelectedItem="{Binding SelectedPeer}"
                            ItemDisplayBinding="{Binding Name}" />
                    <Label Text="Najpierw połącz urządzenia na karcie Połączenia."
                           FontSize="12"
                           TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                </VerticalStackLayout>
            </Border>

            <!-- Wybór zakresu synchronizacji -->
            <Border Padding="15" StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#475569}"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E293B}"
                    StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="9">
                    <Label Text="2. Zliczenia do synchronizacji"
                           FontSize="17" FontAttributes="Bold" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Categories}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Padding="0,4">
                                    <CheckBox IsChecked="{Binding IsSelected}"
                                              VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding Name}"
                                           FontSize="16" VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Label Text="Niezaznaczone zliczenia pozostaną bez zmian na obu urządzeniach."
                           FontSize="12"
                           TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                </VerticalStackLayout>
            </Border>

            <!-- Wybór typu synchronizacji -->
            <Border Padding="15" StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#475569}"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1E293B}"
                    StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="11">
                    <Label Text="3. Typ synchronizacji"
                           FontSize="17" FontAttributes="Bold" />
                    <Picker Title="Wybierz sposób synchronizacji"
                            ItemsSource="{Binding Modes}"
                            SelectedItem="{Binding SelectedMode}" />
                    <Label Text="{Binding ModeDescription}"
                           FontSize="12" LineBreakMode="WordWrap"
                           TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />

                    <VerticalStackLayout IsVisible="{Binding IsOverwrite}"
                                         Spacing="7">
                        <BoxView HeightRequest="1"
                                 Color="{AppThemeBinding Light=#CBD5E1, Dark=#475569}" />
                        <Label Text="Z którego urządzenia skopiować dane?"
                               FontSize="14" FontAttributes="Bold" />
                        <Picker Title="Urządzenie źródłowe"
                                ItemsSource="{Binding Sources}"
                                SelectedItem="{Binding SelectedSource}" />
                        <Label Text="Wybrane zliczenia na drugim urządzeniu zostaną nadpisane."
                               FontSize="12" TextColor="{AppThemeBinding Light=#B45309, Dark=#FBBF24}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Uruchomienie -->
            <Button Text="Synchronizuj zliczenia"
                    FontAttributes="Bold" HeightRequest="50"
                    Command="{Binding SynchronizeCommand}"
                    IsEnabled="{Binding CanSync}" />
            <HorizontalStackLayout Spacing="10">
                <ActivityIndicator IsVisible="{Binding IsBusy}"
                                   IsRunning="{Binding IsBusy}"
                                   WidthRequest="22" HeightRequest="22" />
                <Label Text="{Binding Status}" FontSize="13"
                       VerticalOptions="Center" LineBreakMode="WordWrap"
                       TextColor="{AppThemeBinding Light=#475569, Dark=#CBD5E1}" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
