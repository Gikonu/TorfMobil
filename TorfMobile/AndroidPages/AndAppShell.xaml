<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TorfMobile.AndAppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:TorfMobile"
    Title="TorfMobile">

    <TabBar>
        <ShellContent
            Title="Home"
            ContentTemplate="{DataTemplate local:AndMainPage}"
            Route="AndMainPage" />
        <ShellContent
            Title="Folia"
            ContentTemplate="{DataTemplate local:AndFoilPage}"
            Route="AndFoilPage" />
        <ShellContent
            Title="Kalkulator"
            ContentTemplate="{DataTemplate local:AndFoilCalculatorPage}"
            Route="AndCalculatorPage" />
        <ShellContent
            Title="Połączenia"
            ContentTemplate="{DataTemplate local:AndConnectionPage}"
            Route="AndConnectionPage" />
        <ShellContent
            Title="Synchronizacja"
            ContentTemplate="{DataTemplate local:AndSyncPage}"
            Route="AndSyncPage" />
    </TabBar>
</Shell>
