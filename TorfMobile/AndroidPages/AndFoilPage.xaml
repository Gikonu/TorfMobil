<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TorfMobile.AndFoilPage"
             Title="Folia">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- Nagłówek -->
            <Label
                Text="Zliczanie stanu magazynu"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <!-- Sekcja dodawania -->
            <Border Padding="15" BackgroundColor="Black" Stroke="Black">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">

                    <Label
                        Text="Dodaj nowy wpis"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="White"/>

                    <!-- Wybór asortymentu -->
                    <Picker
                        Title="Wybierz produkt"
                        x:Name="ProductPicker"
                        TextColor="White">
                    </Picker>

                    <!-- Ilość -->
                    <Entry
                        x:Name="QuantityEntry"
                        Placeholder="Podaj ilość (mb)"
                        Keyboard="Numeric"
                        TextColor="White"/>

                    <!-- Przycisk -->
                    <Button
                        x:Name="AddButton"
                        Text="Dodaj do stanu"
                        HeightRequest="50" 
                        Clicked="OnAddCliced"/>

                    <Button
                        x:Name="ResetButton"
                        Text="Zresetuj magazyn"
                        HeightRequest="50" 
                        Clicked="OnResetCliced"/>
                </VerticalStackLayout>
            </Border>

            <!-- Wybór trybu widoku -->
            <Border Padding="15" BackgroundColor="Black" Stroke="Black">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="Widok danych"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="White"/>

                    <!--
                    1 = Kolejność dodawania
                    0 = Pełny stan wszystkich
                    -->
                    <Picker
                        x:Name="ViewModePicker"
                        Title="Wybierz sposób wyświetlania"
                        SelectedIndexChanged="OnViewChange"
                        TextColor="White">
                        <Picker.Items>
                            <x:String>Pełny stan magazynu</x:String>
                            <x:String>Historia zliczania</x:String>
                        </Picker.Items>
                    </Picker>
                </VerticalStackLayout>
            </Border>

            <!-- Widok 1: Historia -->
            <VerticalStackLayout x:Name="HistoryView" Spacing="8">

                <Label
                    Text="Historia zliczania"
                    FontSize="18"
                    FontAttributes="Bold" />

                <CollectionView x:Name="HistoryCollection">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10" Margin="0,4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label
                                        Text="{Binding Name}"
                                        FontSize="16" />

                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding Amount}"
                                        FontAttributes="Bold" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>