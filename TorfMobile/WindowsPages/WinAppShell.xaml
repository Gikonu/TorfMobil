<?xml version="1.0" encoding="utf-8" ?>
    
<Shell
    x:Class="TorfMobile.WinAppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:TorfMobile"
    FlyoutBehavior="Locked"
    FlyoutWidth="180">

    <Shell.MenuBarItems>
        
        <MenuBarItem Text="Plik">
            
            <MenuFlyoutSubItem Text="Import">
                
                <MenuFlyoutItem Text="Excel" IsEnabled="False"/>
                
            </MenuFlyoutSubItem>
            
            <MenuFlyoutSubItem Text="Ekport">
                
                <MenuFlyoutItem Text="Excel" IsEnabled="False"/>
                
            </MenuFlyoutSubItem>
            
        </MenuBarItem>
        
        <MenuBarItem Text="System">
            
            <MenuFlyoutItem Text="Połącz" IsEnabled="False"/>
            
        </MenuBarItem>
        
    </Shell.MenuBarItems>
    
    <Shell.FlyoutContent>

        <Grid
            BackgroundColor="#202020"
            RowDefinitions="Auto,*,Auto"
            >

            <!-- NAGŁÓWEK -->
            <VerticalStackLayout
                Grid.Row="0"
                Padding="15,20,15,15">

                <Label
                    Text="TORFMOBILE"
                    FontSize="18"
                    FontAttributes="Bold"
                    TextColor="White"/>

            </VerticalStackLayout>


            <!-- MENU -->
            <VerticalStackLayout
                Grid.Row="1"
                Padding="8,5"
                Spacing="3">

                <!-- HOME -->
                <Border
                    x:Name="HomeItem"
                    HeightRequest="42"
                    Padding="10,0"
                    StrokeThickness="0"
                    BackgroundColor="#3A3A3A">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Tapped="HomeClicked"/>
                    </Border.GestureRecognizers>

                    <HorizontalStackLayout
                        Spacing="10"
                        VerticalOptions="Center">

                        <Label
                            Text="⌂"
                            FontSize="20"
                            TextColor="White"/>

                        <Label
                            Text="Home"
                            FontSize="14"
                            TextColor="White"
                            VerticalOptions="Center"/>

                    </HorizontalStackLayout>

                </Border>


                <!-- FOLIA -->
                <Border
                    x:Name="FoilItem"
                    HeightRequest="42"
                    Padding="10,0"
                    StrokeThickness="0"
                    BackgroundColor="Transparent">

                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Tapped="FoilClicked"/>
                    </Border.GestureRecognizers>

                    <HorizontalStackLayout
                        Spacing="10"
                        VerticalOptions="Center">

                        <Label
                            Text="▣"
                            FontSize="18"
                            TextColor="White"/>

                        <Label
                            Text="Folia"
                            FontSize="14"
                            TextColor="White"
                            VerticalOptions="Center"/>

                    </HorizontalStackLayout>

                </Border>

            </VerticalStackLayout>


            <!-- USTAWIENIA -->
            <Border
                Grid.Row="2"
                x:Name="SettingsItem"
                HeightRequest="42"
                Margin="8,5,8,15"
                Padding="10,0"
                StrokeThickness="0"
                BackgroundColor="Transparent">

                

                <HorizontalStackLayout
                    Spacing="10"
                    VerticalOptions="Center">

                    <Label
                        Text="⚙"
                        FontSize="18"
                        TextColor="White"/>

                    <Label
                        Text="Ustawienia"
                        FontSize="14"
                        TextColor="White"
                        VerticalOptions="Center"/>

                </HorizontalStackLayout>

            </Border>

        </Grid>

    </Shell.FlyoutContent>


    <!-- STRONY -->

    <ShellContent
        Route="WinMainPage"
        ContentTemplate="{DataTemplate local:WinMainPage}"/>

    <ShellContent
        Route="WinFoilPage"
        ContentTemplate="{DataTemplate local:WinFoilPage}"/>

</Shell>