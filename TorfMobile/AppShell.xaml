<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TorfMobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:TorfMobile"
    Title="TorfMobile">

    <TabBar>
        <ShellContent
            Title="Home"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />
        <ShellContent
            Title="Folia"
            ContentTemplate="{DataTemplate local:FoilPage}"
            Route="FoilPage" />
        <ShellContent
            Title="Kalkulator"
            ContentTemplate="{DataTemplate local:FoilCalculatorPage}"
            Route="CalculatorPage" />
    </TabBar>
</Shell>
